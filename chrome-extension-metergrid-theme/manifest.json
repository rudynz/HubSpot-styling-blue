{
  "manifest_version": 3,
  "name": "HubSpot Theme Changer - metergrid",
  "version": "1.2.0",
  "description": "HubSpot Theme Changer mit metergrid-CI/CD-Theme und erweiterter Variablenabdeckung (fwc-* Framework Web Components).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.hubspot.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hubspot.com/*"
      ],
      "js": [
        "themes_v2.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
